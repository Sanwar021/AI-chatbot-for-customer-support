# SupportPilot Production Environment Configuration
# General Application
APP_NAME=SupportPilot
APP_ENV=development
DEBUG=True
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Security
SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars-long
ENCRYPTION_KEY=64byteHexOrBase64KeyForEncryptingIntegrationTokensHere123456=
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
# For Docker / Production: postgresql+psycopg2://postgres:postgres@db:5432/supportpilot
# For Local Dev / Test fallback: sqlite:///./supportpilot.db
DATABASE_URL=sqlite:///./supportpilot.db

# Background Queue & Cache (Optional in local dev fallback mode, required in Docker)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Providers: "mock" (default for testing/offline), "gemini"
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Meta WhatsApp Cloud API
WHATSAPP_APP_SECRET=meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=supportpilot_meta_webhook_secret_verify_token
WHATSAPP_API_VERSION=v20.0

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@supportpilot.ai

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Billing & Stripe (Optional)
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
